<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ header.name }} -- CV</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: {{ 'letter' if page_format == 'letter' else 'A4' }};
  margin: 0.45in 0.55in;
  background: #fdfafb;
}

html, body {
  font-family: 'Atkinson Hyperlegible', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 9.5pt;
  line-height: 1.3;
  color: #3e3235;
  background: #fdfafb;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.page {
  width: {{ '8.5in' if page_format == 'letter' else '210mm' }};
  padding: 0.45in 0.55in;
  margin: 0 auto;
}

/* The preview uses .page padding. Printed pages use @page margins so every
   continuation page receives the same whitespace. */
@media print {
  .page { width: auto; padding: 0; margin: 0; }
  .entry:last-child, .edu-entry:last-child, .skill-line:last-child { margin-bottom: 0; }
  .section-title { break-after: avoid; }
}

/* --- Header --- */
.header {
  margin-bottom: 10pt;
  border-bottom: 1.5px solid #e4dcde;
  padding-bottom: 8pt;
}

.header h1 {
  font-size: 22pt;
  font-weight: 700;
  color: #1d181a;
  line-height: 1.1;
  letter-spacing: -0.4px;
  margin-bottom: 2pt;
}

.header .title-line {
  font-size: 10pt;
  font-weight: 600;
  color: #a36775;
  margin-bottom: 4pt;
}

.header .contact {
  font-size: 8.5pt;
  color: #6b5f62;
  display: flex;
  flex-wrap: wrap;
  gap: 0 12pt;
  line-height: 1.6;
}

.header .contact a {
  color: #a36775;
  text-decoration: none;
  font-weight: 500;
}

.header .contact a:hover {
  color: #824a57;
  text-decoration: underline;
}

/* --- Section --- */
.section { margin-top: 10pt; }

.section-title {
  font-size: 8.5pt;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #a36775;
  margin-bottom: 5pt;
  padding-bottom: 2pt;
  border-bottom: 1px solid #e4dcde;
}

/* --- Summary --- */
.summary-text {
  font-size: 9.5pt;
  line-height: 1.35;
  color: #4a4042;
  border-left: 2.5px solid #c48e9a;
  padding-left: 10pt;
}

/* --- Experience --- */
.entry { margin-bottom: 7pt; }

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.entry-primary {
  font-weight: 600;
  font-size: 10pt;
  color: #1d181a;
}
.entry-date {
  font-size: 8.5pt;
  font-weight: 500;
  color: #8b7d81;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.entry-secondary {
  font-size: 9pt;
  font-weight: 500;
  color: #6b5f62;
}
.entry-location {
  font-size: 8.5pt;
  color: #8b7d81;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}

.entry-description {
  margin-top: 2pt;
  font-size: 9pt;
  color: #5c4f52;
}

.entry-url {
  font-size: 8pt;
  color: #a36775;
  margin-top: 1pt;
}
.entry-url a {
  color: #a36775;
  text-decoration: none;
}
.entry-url a:hover {
  text-decoration: underline;
}

ul.bullets {
  list-style: none;
  margin-left: 0;
  margin-top: 3pt;
}

ul.bullets li {
  margin-bottom: 2pt;
  font-size: 9.5pt;
  line-height: 1.25;
  padding-left: 10pt;
  position: relative;
  color: #3e3235;
}

ul.bullets li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5pt;
  width: 3.5pt;
  height: 3.5pt;
  background: #c48e9a;
  border-radius: 50%;
}

/* --- Skills --- */
.skills-grid {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 2pt 12pt;
  font-size: 9.5pt;
}
.skill-label {
  font-weight: 600;
  color: #272123;
  white-space: nowrap;
}
.skill-value { color: #5c4f52; }

/* --- Education --- */
.edu-entry { margin-bottom: 4pt; }
.edu-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.edu-school { font-weight: 600; font-size: 9.5pt; color: #1d181a; }
.edu-location {
  font-size: 8.5pt;
  color: #8b7d81;
  text-align: right;
  white-space: nowrap;
  margin-left: 8pt;
}
.edu-degree { font-size: 9pt; color: #6b5f62; }
</style>
</head>
<body>
<div class="page">

  {% if header %}
  <div class="header">
    <h1>{{ header.name }}</h1>
    {# R3-B-01: optional headline. Absent when empty, so nothing shifts. #}
    {% if header.title %}<div class="title-line">{{ header.title }}</div>{% endif %}
    <div class="contact">
      {% for item in (header.contact_items or []) %}
        {% if item.url %}
          {% set href = item.url if (item.url.startswith('http') or item.url.startswith('mailto')) else 'https://' ~ item.url %}
          <a href="{{ href }}">{{ item.text }}</a>
        {% else %}
          <span>{{ item.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if summary %}
  <div class="section" style="margin-top: 2pt">
    <div class="summary-text">{{ summary }}</div>
  </div>
  {% endif %}

  {% if experience %}
  <div class="section">
    <div class="section-title">Experiencia</div>
    {% for job in experience %}
    <div class="entry">
      <div class="entry-row">
        <span class="entry-primary">{{ job.title }}{% if job.company %} <span style="font-weight:400;color:#6b5f62">en</span> <span style="font-weight:600;color:#3e3235">{{ job.company }}</span>{% endif %}</span>
        <span class="entry-date">{{ job.dates }}</span>
      </div>
      {% if job.location %}
      <div style="font-size: 8.5pt; color: #8b7d81;">{{ job.location }}</div>
      {% endif %}
      {% if job.description %}
      <div class="entry-description">{{ job.description }}</div>
      {% endif %}
      {% if job.bullets %}
      <ul class="bullets">
        {% for bullet in job.bullets %}
        <li>{{ bullet | bold }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if skills %}
  <div class="section">
    <div class="section-title">Habilidades</div>
    <div class="skills-grid">
      {% if skills is mapping %}
        {% for label, value in skills.items() %}
        <span class="skill-label">{{ label }}</span>
        <span class="skill-value">{{ (value | join(', ')) if (value is iterable and value is not string) else (value or '') }}</span>
        {% endfor %}
      {% else %}
        {% for sk in skills %}
        {% set items_val = sk['items'] if 'items' in sk else '' %}
        <span class="skill-label">{{ sk.category }}</span>
        <span class="skill-value">{{ (items_val | join(', ')) if (items_val is iterable and items_val is not string) else items_val }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% if education %}
  <div class="section">
    <div class="section-title">Educación</div>
    {% for edu in education %}
    <div class="edu-entry">
      <div class="edu-row">
        <span class="edu-school">{{ edu.school }}</span>
        <span class="edu-location">{{ edu.location }}</span>
      </div>
      {% if edu.degree %}
      <div class="edu-degree">{{ edu.degree }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if projects %}
  <div class="section">
    <div class="section-title">Proyectos</div>
    {% for project in projects %}
    <div class="entry">
      <div class="entry-primary">{{ project.name or project.title }}</div>
      {% if project.url %}<div class="entry-url"><a href="{{ project.url }}">{{ project.url }}</a></div>{% endif %}
      {% if project.description %}<div class="entry-description">{{ project.description }}</div>{% endif %}
      {% if project.bullets %}
      <ul class="bullets">
        {% for bullet in project.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if publications %}
  <div class="section">
    <div class="section-title">Publicaciones</div>
    {% for pub in publications %}
    <div class="entry">
      <div class="entry-primary">{{ pub.name or pub.title }}</div>
      {% if pub.description %}<div class="entry-description">{{ pub.description }}</div>{% endif %}
      {% if pub.bullets %}
      <ul class="bullets">
        {% for bullet in pub.bullets %}<li>{{ bullet | bold }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
</body>
</html>
